{
  "name": "quiick-delivery-partner-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "adb reverse tcp:8082 tcp:8082 2>/dev/null; adb reverse tcp:3040 tcp:3040 2>/dev/null; expo start --go --lan --port 8082",
    "start:clear": "expo start --go --lan --port 8082 -c",
    "start:lan": "expo start --go --lan --port 8082",
    "start:phone": "expo start --go --tunnel --port 8082",
    "start:tunnel": "expo start --go --tunnel --port 8082",
    "start:usb": "adb reverse tcp:8082 tcp:8082 && adb reverse tcp:3040 tcp:3040 && EXPO_PUBLIC_API_VIA_ADB=true EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3040 expo start --go --localhost --port 8082",
    "start:dev-client": "expo start --dev-client --lan --port 8082",
    "android": "expo run:android",
    "dev:android": "expo run:android --device",
    "ios": "expo run:ios",
    "dev:ios": "expo run:ios --device",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.102.8",
    "babel-preset-expo": "~57.0.0",
    "date-fns": "^4.4.0",
    "expo": "^57.0.27",
    "expo-constants": "~57.0.16",
    "expo-dev-client": "~57.0.18",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.2",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.14",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.12",
    "expo-location": "~57.0.14",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.21",
    "react": "19.2.3",
    "react-hook-form": "^7.87.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "babel-plugin-module-resolver": "^5.0.3",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-dom": "19.2.3"
  }
}
