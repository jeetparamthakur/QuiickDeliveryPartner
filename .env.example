# QuickmartcoreBackend on your machine (default port 3000).
# Keep localhost for Expo Go on a real device — the app rewrites it to your computer's LAN IP
# from Metro (hostUri / debuggerHost). Phone and laptop should be on the same Wi‑Fi, or use
# `npm start` (tunnel). USB Android: `npm run start:usb` and optionally: adb reverse tcp:3000 tcp:3000
#
# If requests still hit localhost on device, set your laptop LAN IP instead:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:3000
#
# Start the API: cd QuickmartcoreBackend && npm run dev
RCT_METRO_PORT=8082
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_API_VERSION=v1
# true = offline UI only; no real API calls
EXPO_PUBLIC_USE_MOCK_API=false
EXPO_PUBLIC_API_DEBUG=true
